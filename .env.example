# ============================================================
# Akusara Digital — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Resend API key for contact form email delivery
# Get one at https://resend.com/api-keys
# If not set, the contact form falls back to WhatsApp deep link
RESEND_API_KEY=

# Email address where contact form submissions are received
CONTACT_EMAIL=halo@akusara.digital

# Site URL (used for metadataBase, sitemap, robots)
# In production, set this to your actual domain
NEXT_PUBLIC_SITE_URL=https://akusara.digital
